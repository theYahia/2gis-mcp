{
  "name": "@theyahia/2gis-mcp",
  "version": "1.1.0",
  "description": "MCP server for 2GIS — places, geocoding, directions, public transport, suggest, reviews (Russia/CIS)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "2gis-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "2gis",
    "russian-api",
    "maps",
    "geocoding",
    "places",
    "directions",
    "routing",
    "public-transport",
    "typescript",
    "api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/2gis-mcp.git"
  },
  "homepage": "https://github.com/theYahia/2gis-mcp#readme",
  "bugs": {
    "url": "https://github.com/theYahia/2gis-mcp/issues"
  },
  "author": "theYahia"
}
